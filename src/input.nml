
&FEISTY_nml
! Spinup parameters: ---------------------------------------------
        Year_2_Spinup = 100
        Spinup = .false.
!
! Environemental data for test: -----------------------------------
        diagnostic           = .false.   ! True to run debug mode 
        save_diagnostics     = .true.
        prod_constrained     = .true.
        Spinup_Time_Serie    = .true.
        Initial_Condition_generic_FEISTY = .true.
        largDemPel           = .false.
!
! Simulation parameters: ------------------------------------------
        Delta_t          = 1.0             ! Time step [d]
        IC               = 1d-5            ! Fish Initial Condition
        PI_be_cutoff     = 200.00          ! Benthic-pelagic coupling cutoff (depth, m)
!
! Experimentation parameters: ------------------------------------------
        loc = "GOM"
        exp = "2D" ! "COBALT_offline_BATS"
        coupling = "offline"
!
! input files: ----------------------------------------------------
        root_dir_output = "/project/rdenechere/COBALT_output/COBALT_offline_forcing_files/"
        root_dir_loc = "/project/rdenechere/CEFI-regional-MOM6-FEISTY/exps/OM4.single_column.COBALT/"